# Copy to source.env, chmod 600, and keep it private. Never commit the real file.
# Values are assignments, not shell commands. Use quotes around spaces.
SOURCE_SSH_HOST=""
SOURCE_SSH_USER=""
SOURCE_SSH_PORT="22"
SOURCE_SSH_IDENTITY_FILE="${HOME}/.ssh/onionsurge_reader"
SOURCE_SSH_KNOWN_HOSTS_FILE="${HOME}/.ssh/onionsurge_known_hosts"
# Optional private historical seed snapshot (mode 0600, regular non-symlink file);
# defaults to inputs/snapshot.json when unset or empty.
